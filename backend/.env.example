# Backend Production Environment Variables

# MongoDB Connection String (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/void?retryWrites=true&w=majority

# JWT Secret for Auth (use a secure random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (Important for CORS)
# Replace with your deployed frontend URL (e.g. https://void.vercel.app)
FRONTEND_URL=https://void-workspace.com

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here
